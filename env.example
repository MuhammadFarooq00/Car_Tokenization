# Environment Variables Template
# Copy this file to .env and fill in your values

# ============ Network RPC URLs ============
# Ethereum Mainnet
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# or use Infura: https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Sepolia Testnet
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Goerli Testnet (deprecated)
GOERLI_RPC_URL=https://eth-goerli.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ============ Private Key ============
# WARNING: Never commit your actual private key!
# Use a dedicated deployment wallet with limited funds
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# ============ Block Explorer API Keys ============
# Etherscan (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ============ Gas Reporting ============
# Enable gas reporting (true/false)
REPORT_GAS=false

# CoinMarketCap API key for USD gas costs
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# ============ Notes ============
# - Get Alchemy API key: https://www.alchemy.com/
# - Get Infura API key: https://www.infura.io/
# - Get Etherscan API key: https://etherscan.io/myapikey
# - Get CoinMarketCap API key: https://coinmarketcap.com/api/
# - Get Geoapify API key: https://myprojects.geoapify.com/ (free, no card)
# - NEVER share your private key or commit it to git
# - Add .env to your .gitignore file

# ============ Geoapify (Frontend) ============
# Used for ride pickup/dropoff autocomplete and route distance calculation.
# Free tier: 3,000 requests/day — no credit card required.
VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here
