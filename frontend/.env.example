# Frontend Environment Variables
# Copy this file to .env and fill in the values

# Backend API URL
VITE_API_URL=http://localhost:3000

# Reown (WalletConnect) Project ID
# Get yours at https://cloud.reown.com
VITE_REOWN_PROJECT_ID=c393f03d1f1862474d10921e825246ca

# IPFS Gateway (optional - defaults to Pinata)
# VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Pinata API Key for IPFS uploads (optional - required for car creation)
# VITE_PINATA_API_KEY=
# VITE_PINATA_SECRET_KEY=

# Geoapify API Key (for ride pickup/dropoff autocomplete & route calculation)
# Free tier: 3,000 requests/day — no credit card required
# Get yours at https://myprojects.geoapify.com/
VITE_GEOAPIFY_API_KEY=85968b6af7c34b35b47604d73bd2025e